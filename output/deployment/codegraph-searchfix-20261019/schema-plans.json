      "sql": "CREATE TRIGGER nodes_ai AFTER INSERT ON nodes BEGIN\n    INSERT INTO nodes_fts(rowid, id, name, qualified_name, docstring, signature)\n    VALUES (NEW.rowid, NEW.id, NEW.name, NEW.qualified_name, NEW.docstring, NEW.signature);\nEND"
    },
    {
      "type": "trigger",
      "name": "nodes_au",
      "tbl_name": "nodes",
      "sql": "CREATE TRIGGER nodes_au AFTER UPDATE ON nodes BEGIN\n    INSERT INTO nodes_fts(nodes_fts, rowid, id, name, qualified_name, docstring, signature)\n    VALUES ('delete', OLD.rowid, OLD.id, OLD.name, OLD.qualified_name, OLD.docstring, OLD.signature);\n    INSERT INTO nodes_fts(rowid, id, name, qualified_name, docstring, signature)\n    VALUES (NEW.rowid, NEW.id, NEW.name, NEW.qualified_name, NEW.docstring, NEW.signature);\nEND"
    }
